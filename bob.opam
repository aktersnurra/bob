# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Bob — a small curious desktop robot"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.24"}
  "mtime"
  "ptime"
  "yojson"
  "uuidm"
  "sqlite3"
  "cmdliner"
  "logs"
  "fmt"
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
